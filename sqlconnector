def open_3():
    global uid
    s3 = tk.Toplevel()
    s3.title("Sign Up")
    s3.attributes('-fullscreen', True)
    bg = ImageTk.PhotoImage(Image.open("3.png").resize((s3.winfo_screenwidth(), s3.winfo_screenheight())))
    tk.Label(s3, image=bg).place(relwidth=1, relheight=1)
    s3.bg = bg

    phone_entry = tk.Entry(s3)
    phone_entry.place(relx=0.83, rely=0.35, anchor='nw')
    email_entry = tk.Entry(s3)
    email_entry.place(relx=0.72, rely=0.53, anchor='nw')
    uid_entry = tk.Entry(s3)
    uid_entry.place(relx=0.77, rely=0.70, anchor='nw')
    pass_entry = tk.Entry(s3, show="*")
    pass_entry.place(relx=0.77, rely=0.88, anchor='nw')

    def handle_signup():
        global uid
        phone = phone_entry.get()
        email = email_entry.get()
        username = uid_entry.get()
        password = pass_entry.get()
        if phone and email and username and password:
            try:
                if phone.isdigit() and len(phone) == 10:
                    sqlconnector.signup(phone, email, username, password)
                    uid = username
                    messagebox.showinfo("Signup Successful", f"Welcome, {username}!")
                    s3.destroy()
                    open_5()
                else:
                    messagebox.showerror("Phone Number", "Please enter a 10-digit phone number.")
            except Exception as e:
                messagebox.showerror("Signup Failed", str(e))
        else:
            messagebox.showwarning("Incomplete", "Please fill all fields.")

    tk.Button(s3, text="Submit", command=handle_signup, **button_style2).place(relx=0.89, rely=0.92, anchor='nw')
    tk.Button(s3, text="Back", command=lambda: (s3.destroy(), open_2()), **button_style2).place(relx=0.03, rely=0.92, anchor='nw')


