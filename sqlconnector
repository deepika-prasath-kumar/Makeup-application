def open_cart_window(items):
    cart_window = tk.Toplevel()
    cart_window.title("Makeup Shop - Cart")
    cart_window.geometry("1400x750")

    bg_image = Image.open("12.png").resize((1400, 750))
    bg_photo = ImageTk.PhotoImage(bg_image)
    bg_label = tk.Label(cart_window, image=bg_photo)
    bg_label.image = bg_photo
    bg_label.place(x=0, y=0, relwidth=1, relheight=1)

    item_data = {name: {"price": price, "qty": qty} for name, price, qty in items}
    qty_vars = {}
    total_vars = {}
    subtotal_var = tk.DoubleVar()

    scroll_frame = tk.Frame(cart_window, bg="white", bd=2, relief="solid")
    scroll_frame.place(relx=0.5, rely=0.45, anchor="center", width=700, height=350)

    scroll_canvas = tk.Canvas(scroll_frame, bg='#ffffff', highlightthickness=0)
    scroll_canvas.pack(side="left", fill="both", expand=True)

    scrollbar = tk.Scrollbar(scroll_frame, orient="vertical", command=scroll_canvas.yview)
    scrollbar.pack(side="right", fill="y")
    scroll_canvas.configure(yscrollcommand=scrollbar.set)

    container = tk.Frame(scroll_canvas, bg="white")
    scroll_canvas.create_window((0, 0), window=container, anchor="nw")

    def on_frame_configure(event):
        scroll_canvas.configure(scrollregion=scroll_canvas.bbox("all"))

    container.bind("<Configure>", on_frame_configure)

    headers = ["Item", "Qty", "Price", "Total"]
    i = 0
    while i < len(headers):
        tk.Label(container, text=headers[i], bg="white", font=("Arial", 10, "bold")).grid(row=0, column=i, padx=10, pady=10)
        i += 1

    def update_subtotal():
        total = sum(item_data[name]["qty"] * item_data[name]["price"] for name in item_data)
        subtotal_var.set(total)
        subtotal_label.config(text=f"₹{total:.2f}")

    def change_qty(name, delta):
        qty = max(0, qty_vars[name].get() + delta)
        qty_vars[name].set(qty)
        item_data[name]["qty"] = qty
        total_vars[name].set(qty * item_data[name]["price"])
        update_subtotal()

    row = 1
    for name in item_data:
        info = item_data[name]
        tk.Label(container, text=name, bg="white").grid(row=row, column=0, padx=10, pady=5)

        qty_var = tk.IntVar(value=info["qty"])
        qty_vars[name] = qty_var

        total_var = tk.DoubleVar(value=info["price"] * info["qty"])
        total_vars[name] = total_var

        qty_frame = tk.Frame(container, bg='#4f1104')
        qty_frame.grid(row=row, column=1)
        tk.Button(qty_frame, text="-", command=lambda n=name: change_qty(n, -1)).pack(side="left")
        tk.Label(qty_frame, textvariable=qty_var, width=3, bg="white").pack(side="left")
        tk.Button(qty_frame, text="+", command=lambda n=name: change_qty(n, 1)).pack(side="left")

        tk.Label(container, text=f"₹{info['price']:.2f}", bg="white").grid(row=row, column=2)
        tk.Label(container, textvariable=total_var, bg="white").grid(row=row, column=3)
        row += 1

    tk.Label(container, text="Subtotal:", font=("Arial", 12, "bold"), bg="white").grid(row=row, column=2, sticky="e", padx=5, pady=10)
    subtotal_label = tk.Label(container, font=("Arial", 12), bg="white")
    subtotal_label.grid(row=row, column=3, sticky="w", padx=5, pady=10)

    def checkout_action():
        global sample_items, total_price
        sample_items = []
        total_price = 0
        global q
        q = 0
        for name in item_data:
            price = item_data[name]["price"]
            qty = item_data[name]["qty"]
            if qty > 0:
                sample_items.append((name, price, qty))
                total_price += price * qty
                q = q + qty
        tid = sqlconnector.get_transaction_id()
        sqlconnector.update_qty(q, total_price, tid)
        messagebox.showinfo("Checkout", f"Your total is ₹{total_price:.2f}. Thank you for shopping!")
        cart_window.destroy()
        open_8()
        if item_data == []:
            messagebox.showinfo("No products selected")
            cart_window.destroy()
            open_5()

    tk.Button(cart_window, text="Checkout", command=checkout_action, **button_style2).place(relx=0.86, rely=0.83, anchor='nw')
    tk.Button(cart_window, text="Back", command=lambda: (cart_window.destroy(), open_5()), **button_style2).place(relx=0.866, rely=0.90, anchor='nw')

    update_subtotal()

