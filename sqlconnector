def gotocart():
    global brand_product_map, uid
    if not brand_product_map:
        messagebox.showwarning("No Items", "Your cart is empty!")
        return
    global l
    transaction_lines = []
    t_price = []
    t_brand = []
    total_quantity = 0
    global total_price
    total_price = 0

    for brand, products in brand_product_map.items():
        for product, price in products:
            transaction_lines.append(f"{brand}: {product} - Rs.{price}")
            t_brand.append(f"{brand}: {product}")
            t_price.append(f"Rs.{price}")
            t = (f"{brand}:{product}", float(price), 1)
            l.append(t)
            total_quantity += 1
            total_price += price

    transaction_str = "\n".join(transaction_lines)
    a = list(brand_product_map.values())
    sqlconnector.add(uid, transaction_str, total_quantity, total_price)
    brand_product_map.clear()


def save_transaction():
    global b, prod, brand_product_map
    if not prod:
        messagebox.showwarning("Empty Cart", "No items selected to save.")
        return
    if b in brand_product_map:
        brand_product_map[b].extend(prod)
    else:
        brand_product_map[b] = prod.copy()
    prod.clear()


def open_popup(item):
    win = tk.Toplevel()
    win.title(f"{item.capitalize()} Options")
    options = {
        "eyeliner": ["Black Eyeliner", "Blue Eyeliner", "Dark Green Eyeliner", "White Eyeliner", "Pink Chrome Eyeliner"],
        "lipstick": ["Pink Lipstick", "Red Lipstick", "Dark Red Lipstick", "Crimson Red Lipstick", "Nude Lipstick"],
        "blush": ["Pink Blush", "Red Blush", "Orange Blush", "Purple Blush", "Burgundy Blush"],
        "foundation": ["Chestnut Foundation", "Tan Foundation", "Caramel Foundation", "Hazel Foundation", "Ollie Foundation"],
        "lipgloss": ["Clear Lipgloss", "Pink Tinted Lipgloss", "Chocolate Lipgloss", "Berry Lipgloss", "Choco Mint Lipgloss"],
        "eyeshadow": ["Metallic Eyeshadow Palette", "Pastel Eyeshadow Palette", "Liquid Eyeshadow", "Loose Glitter Eyeshadow", "Cream Eyeshadow"],
    }

    def add_product(opt):
        global tot, b, prod
        price = sqlconnector.getprice(b, opt)
        if price is not None:
            prod.append((opt, price))
            tot += price

    for option in options.get(item, []):
        tk.Button(win, text=option, font=("Perandory Cond", 13), command=lambda opt=option: add_product(opt)).pack(pady=5)
    tk.Button(win, text="Close", command=win.destroy).pack(pady=10)


